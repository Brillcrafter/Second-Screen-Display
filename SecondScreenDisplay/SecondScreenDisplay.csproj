<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>ClientPlugin</RootNamespace>
    <AssemblyName>SecondScreenDisplay</AssemblyName>
    <!-- Avalonia XAML compiler needs this -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <!-- Update this path for your OS / SE install location -->
    <OutputPath>$(SEBin64)\Plugins\Local\SecondScreenDisplay</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(SEBin64)\Plugins\Local\SecondScreenDisplay</OutputPath>
  </PropertyGroup>

  <!-- ── Avalonia packages ──────────────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="Avalonia"                   Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop"           Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent"     Version="11.2.3" />
    <PackageReference Include="Lib.Harmony"                Version="2.3.6"  />
  </ItemGroup>

  <!-- ── Space Engineers / VRage assemblies (non-private, from $(Bin64)) -->
  <ItemGroup>
    <Reference Include="Sandbox.Common">
      <HintPath>$(Bin64)\Sandbox.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sandbox.Game">
      <HintPath>$(Bin64)\Sandbox.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sandbox.Graphics">
      <HintPath>$(Bin64)\Sandbox.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SpaceEngineers.Game">
      <HintPath>$(Bin64)\SpaceEngineers.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SpaceEngineers.ObjectBuilders">
      <HintPath>$(Bin64)\SpaceEngineers.ObjectBuilders.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage">
      <HintPath>$(Bin64)\VRage.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Game">
      <HintPath>$(Bin64)\VRage.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Library">
      <HintPath>$(Bin64)\VRage.Library.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Math">
      <HintPath>$(Bin64)\VRage.Math.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Scripting">
      <HintPath>$(Bin64)\VRage.Scripting.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Input">
      <HintPath>$(Bin64)\VRage.Input.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Render">
      <HintPath>$(Bin64)\VRage.Render.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.UserInterface">
      <HintPath>$(Bin64)\VRage.UserInterface.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Network">
      <HintPath>$(Bin64)\VRage.Network.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(Bin64)\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(Bin64)\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ── Source files ──────────────────────────────────────────────── -->
  <ItemGroup>
    <Compile Include="Config.cs" />
    <Compile Include="HudLCDPatch.cs" />
    <Compile Include="Plugin.cs" />
    <Compile Include="SessionComp.cs" />
    <Compile Include="SSDApplication.cs" />
    <Compile Include="WindowsThreadManager.cs" />
    <Compile Include="WindowThreadsInter.cs" />
    <!-- Settings subsystem (unchanged) -->
    <Compile Include="Settings\ConfigStorage.cs" />
    <Compile Include="Settings\Elements\Button.cs" />
    <Compile Include="Settings\Elements\Checkbox.cs" />
    <Compile Include="Settings\Elements\Color.cs" />
    <Compile Include="Settings\Elements\Control.cs" />
    <Compile Include="Settings\Elements\Dropdown.cs" />
    <Compile Include="Settings\Elements\Element.cs" />
    <Compile Include="Settings\Elements\Keybind.cs" />
    <Compile Include="Settings\Elements\Slider.cs" />
    <Compile Include="Settings\Elements\Textbox.cs" />
    <Compile Include="Settings\Layouts\Layout.cs" />
    <Compile Include="Settings\Layouts\None.cs" />
    <Compile Include="Settings\Layouts\Simple.cs" />
    <Compile Include="Settings\SettingsGenerator.cs" />
    <Compile Include="Settings\SettingsScreen.cs" />
    <Compile Include="Settings\Tools\Binding.cs" />
    <Compile Include="Settings\Tools\Tools.cs" />
  </ItemGroup>

  <!-- ── Avalonia assets ───────────────────────────────────────────── -->
  <ItemGroup>
    <!-- .axaml files are compiled by Avalonia's build tasks -->
    <AvaloniaResource Include="resources\SecondWindow.axaml" />
    <!-- Custom font embedded as an Avalonia resource -->
    <AvaloniaResource Include="resources\BigBlueTermPlusNerdFontMono-Regular.ttf" />
    <Content Include="PluginHub.xml" />
  </ItemGroup>

</Project>
